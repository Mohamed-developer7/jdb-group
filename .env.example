# ─────────────────────────────────────────────────────────────────────────────
# JDB GROUP — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# All enquiry/contact form submissions are sent via SMTP to CONTACT_EMAIL.
#
# Option A — Gmail App Password (recommended for jdbsays@gmail.com):
#   1. Go to myaccount.google.com → Security → 2-Step Verification → App Passwords
#   2. Create an App Password for "Mail"
#   3. Use that 16-character password as SMTP_PASS below
#
# Option B — Any other SMTP provider (SendGrid, Mailgun, etc.)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jdbsays@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Destination email for all enquiry form submissions
CONTACT_EMAIL=jdbsays@gmail.com
